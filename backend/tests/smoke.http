# Send theo thứ tự: GET /api/csrf → đăng nhập → verify-otp (Admin) → thao tác Admin.
# Với mỗi POST/PUT/PATCH/DELETE, lấy CSRF mới bằng GET /api/csrf ngay trước khi gửi
# và dùng token mới nhất cùng cookie session hiện hành. Chỉ ca kiểm thử CSRF cũ
# bên dưới cố ý dùng token đã lưu để xác nhận request bị từ chối.
# Các giá trị nhạy cảm được hỏi bằng # @prompt ngay trước request cần chúng.
### Giá trị cá nhân/test: chỉ giá trị không nhạy cảm; không điền thông tin thật
@customerName = Test Customer
@adminName = Admin Test
@customerPhone =
@customerEmail =
@unknownCustomerPhone =
@limitedPhone =
@otherCustomerEmail =
@unknownCustomerEmail =
@adminEmail =
@adminPhone =
@categoryId = 1
@productId = 1
@cartProductId =
@cartQuantity = 1
@cartUpdatedQuantity = 2
@nearExpiryProductId =
@searchTerm = sua
@newCategoryName =
@newProductName =
@adminImagePath =
@stockProductId =
@stockReceiptDate =
@manufactureDate =
@expiryDate =
@minPrice =
@maxPrice =
@suggestionProductId =
@expiringDays =
@adjustNewStock =
@adjustReason =
@promotionCode =
@promotionTitle =
@deliveryAreaId = 1
@deliveryAreaProvince =
@deliveryAreaDistrict =
@deliveryAreaWard =
@deliveryAreaDistanceKm =

### Public catalog: danh sách danh mục
GET http://localhost/monsmokee/backend/public/api/categories

### Public catalog: mặc định 12 sản phẩm; pagination có has_more
GET http://localhost/monsmokee/backend/public/api/products?page=1&sort=newest

### Public catalog: tìm kiếm, lọc danh mục và sắp xếp giá tăng dần
GET http://localhost/monsmokee/backend/public/api/products?q={{searchTerm}}&category_id={{categoryId}}&sort=price_asc&page=1&per_page=10

### Public catalog: lọc giá hiệu lực (điền minPrice/maxPrice; có thể bỏ một cận)
GET http://localhost/monsmokee/backend/public/api/products?min_price={{minPrice}}&max_price={{maxPrice}}

### Public catalog: chi tiết sản phẩm (không trả hạn sử dụng)
GET http://localhost/monsmokee/backend/public/api/products/{{productId}}

### Public catalog: gợi ý mua kèm, tối đa 8 sản phẩm (không lộ HSD trừ CAN_HAN)
GET http://localhost/monsmokee/backend/public/api/products/{{suggestionProductId}}/suggestions

### Public catalog: lọc sản phẩm cận hạn; chỉ nhãn CAN_HAN được trả hạn gần nhất
GET http://localhost/monsmokee/backend/public/api/products?near_expiry=1

### Public catalog: sản phẩm thường không có trường han_su_dung
GET http://localhost/monsmokee/backend/public/api/products/{{productId}}

### Public catalog: sản phẩm giảm CAN_HAN có hạn của lô gần nhất còn hàng
GET http://localhost/monsmokee/backend/public/api/products/{{nearExpiryProductId}}

### Public catalog: kiểm thử giá ở Thứ Sáu (chỉ APP_ENV=development)
GET http://localhost/monsmokee/backend/public/api/products/{{productId}}?now=2026-03-06

### Public catalog: chương trình đang chạy (now chỉ dùng trong development)
GET http://localhost/monsmokee/backend/public/api/promotions/active?now=2026-03-06

### Danh sách khu vực giao hàng đang hỗ trợ
GET http://localhost/monsmokee/backend/public/api/shipping/areas

### Lọc khu vực theo tỉnh/quận huyện
GET http://localhost/monsmokee/backend/public/api/shipping/areas?tinh=Qu%E1%BA%A3ng%20B%C3%ACnh&quan_huyen=TP.%20%C4%90%E1%BB%93ng%20H%E1%BB%9Bi

### Thông tin cửa hàng cho footer và Click & Collect
GET http://localhost/monsmokee/backend/public/api/store-info

### 1. Lấy CSRF token; REST Client cần giữ cookie session
# @name csrf
GET http://localhost/monsmokee/backend/public/api/csrf

### Giỏ hàng guest: đọc, kiểm tra giá và tổng tiền (now chỉ trong development)
GET http://localhost/monsmokee/backend/public/api/cart?now=2026-03-06

### Thêm sản phẩm vào giỏ (cùng endpoint dùng guest hoặc Customer session)
POST http://localhost/monsmokee/backend/public/api/cart/items
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "san_pham_id": {{cartProductId}},
  "so_luong": {{cartQuantity}}
}

### Sửa số lượng dòng giỏ
PATCH http://localhost/monsmokee/backend/public/api/cart/items/{{cartProductId}}
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "so_luong": {{cartUpdatedQuantity}}
}

### Xóa một sản phẩm khỏi giỏ
DELETE http://localhost/monsmokee/backend/public/api/cart/items/{{cartProductId}}
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

### Xóa toàn bộ giỏ hiện hành
DELETE http://localhost/monsmokee/backend/public/api/cart
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

### Báo phí ship tạm tính; tiền hàng VND sau giảm
POST http://localhost/monsmokee/backend/public/api/shipping/quote
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "khu_vuc_id": {{deliveryAreaId}},
  "tien_hang_sau_giam": 50000
}

### Admin: danh sách khu vực giao hàng (đăng nhập Admin đã xác thực OTP)
GET http://localhost/monsmokee/backend/public/api/admin/delivery-areas

### Admin: tạo khu vực (dùng dữ liệu thử cục bộ)
POST http://localhost/monsmokee/backend/public/api/admin/delivery-areas
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "tinh": "{{deliveryAreaProvince}}",
  "quan_huyen": "{{deliveryAreaDistrict}}",
  "phuong_xa": "{{deliveryAreaWard}}",
  "khoang_cach_km": {{deliveryAreaDistanceKm}},
  "ho_tro": 1
}

### Admin: cập nhật đầy đủ khu vực
PUT http://localhost/monsmokee/backend/public/api/admin/delivery-areas/{{deliveryAreaId}}
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "tinh": "{{deliveryAreaProvince}}",
  "quan_huyen": "{{deliveryAreaDistrict}}",
  "phuong_xa": "{{deliveryAreaWard}}",
  "khoang_cach_km": {{deliveryAreaDistanceKm}},
  "ho_tro": 1
}

### Admin: tắt khu vực thay vì xóa cứng
PATCH http://localhost/monsmokee/backend/public/api/admin/delivery-areas/{{deliveryAreaId}}/status
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "ho_tro": 0
}

### 2. Chưa đăng nhập vào Admin me - 401
GET http://localhost/monsmokee/backend/public/api/admin/me

### 3. Bắt đầu đăng ký Customer
# @prompt customerPassword Nhập mật khẩu Customer để đăng ký
POST http://localhost/monsmokee/backend/public/api/auth/register/start
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "ho_ten": "{{customerName}}",
  "so_dien_thoai": "{{customerPhone}}",
  "email": "{{customerEmail}}",
  "mat_khau": "{{customerPassword}}",
  "nhap_lai_mat_khau": "{{customerPassword}}"
}

### 4. Gửi lại OTP đăng ký (chỉ chạy sau khi cooldown 60 giây; dùng OTP mới nhất)
POST http://localhost/monsmokee/backend/public/api/auth/otp/resend
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}"
}

### 5. Xác nhận đăng ký; thành công trả 201 và đăng nhập Customer
# @prompt customerOtp Nhập OTP đăng ký vừa nhận
POST http://localhost/monsmokee/backend/public/api/auth/register/verify
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}",
  "otp": "{{customerOtp}}"
}

### 6. Bắt đầu quên mật khẩu Customer - response luôn chung 200
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/start
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}"
}

### Gửi lại ngay - phải trả 429 do cooldown 60 giây
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/resend
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}"
}

### Reset trước khi xác thực OTP - phải trả 422
# @prompt resetTicket Nhập reset ticket kiểm thử (có thể để trống)
# @prompt newPassword Nhập mật khẩu mới dùng cho test
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/reset
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}",
  "reset_ticket": "{{resetTicket}}",
  "mat_khau": "{{newPassword}}",
  "nhap_lai_mat_khau": "{{newPassword}}"
}

### OTP sai - phải trả 422 chung và remaining_attempts cho Customer hợp lệ
# @prompt wrongResetOtp Nhập OTP sai để kiểm tra validation
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/verify-otp
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}",
  "otp": "{{wrongResetOtp}}"
}

### Xác thực OTP đúng - trả reset_ticket, chưa đổi mật khẩu
# @name verifyForgotPasswordOtp
# @prompt resetOtp Nhập OTP quên mật khẩu vừa nhận
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/verify-otp
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}",
  "otp": "{{resetOtp}}"
}

### Email khác không thể dùng ticket - phải trả lỗi chung 422
# @prompt newPassword Nhập mật khẩu mới dùng cho test
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/reset
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{otherCustomerEmail}}",
  "reset_ticket": "{{verifyForgotPasswordOtp.response.body.data.reset_ticket}}",
  "mat_khau": "{{newPassword}}",
  "nhap_lai_mat_khau": "{{newPassword}}"
}

### Đổi mật khẩu bằng reset ticket; thành công không tự đăng nhập
# @prompt newPassword Nhập mật khẩu mới dùng cho test
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/reset
Content-Type: application/json
X-CSRF-Token: {{csrf.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}",
  "reset_ticket": "{{verifyForgotPasswordOtp.response.body.data.reset_ticket}}",
  "mat_khau": "{{newPassword}}",
  "nhap_lai_mat_khau": "{{newPassword}}"
}

###
# @name csrfAfterPasswordReset
GET http://localhost/monsmokee/backend/public/api/csrf

### Dùng lại ticket đã tiêu thụ - phải trả 422
# @prompt newPassword Nhập mật khẩu mới dùng cho test
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/reset
Content-Type: application/json
X-CSRF-Token: {{csrfAfterPasswordReset.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}",
  "reset_ticket": "{{verifyForgotPasswordOtp.response.body.data.reset_ticket}}",
  "mat_khau": "{{newPassword}}",
  "nhap_lai_mat_khau": "{{newPassword}}"
}

### Ticket hết hạn hoặc sai - phải trả cùng lỗi 422
# @prompt expiredResetTicket Nhập reset ticket hết hạn/không hợp lệ
# @prompt newPassword Nhập mật khẩu mới dùng cho test
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/reset
Content-Type: application/json
X-CSRF-Token: {{csrfAfterPasswordReset.response.body.data.csrf_token}}

{
  "email": "{{customerEmail}}",
  "reset_ticket": "{{expiredResetTicket}}",
  "mat_khau": "{{newPassword}}",
  "nhap_lai_mat_khau": "{{newPassword}}"
}

### Email không tồn tại: xác minh OTP cũng phải trả lỗi chung 422, không ticket
# @prompt resetOtp Nhập OTP kiểm thử
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/verify-otp
Content-Type: application/json
X-CSRF-Token: {{csrfAfterPasswordReset.response.body.data.csrf_token}}

{
  "email": "{{unknownCustomerEmail}}",
  "otp": "{{resetOtp}}"
}

### Email Admin: xác minh OTP phải trả lỗi chung 422, không ticket
# @prompt resetOtp Nhập OTP kiểm thử
POST http://localhost/monsmokee/backend/public/api/auth/forgot-password/verify-otp
Content-Type: application/json
X-CSRF-Token: {{csrfAfterPasswordReset.response.body.data.csrf_token}}

{
