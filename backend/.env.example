APP_ENV=development
APP_URL=http://localhost/monsmokee
APP_DEBUG=true
TIMEZONE=Asia/Ho_Chi_Minh

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monsmokee
DB_USER=root
DB_PASS=

MAIL_DRIVER=log
# Placeholder giả, không dùng trực tiếp. Thay trong backend/.env.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail-address@example.invalid
MAIL_PASSWORD=FAKE_APP_PASSWORD_REPLACE_ME
MAIL_FROM=your-gmail-address@example.invalid
MAIL_FROM_NAME=MON SMOKEE

SESSION_NAME=MONSMOKEESID
SESSION_LIFETIME_SECONDS=7200
SESSION_IDLE_TIMEOUT_SECONDS=7200
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800

# Thay bằng thông tin Admin riêng trong backend/.env (không commit file đó).
ADMIN_PHONE=0100000000
ADMIN_PASSWORD=doi-mat-khau-nay
ADMIN_EMAIL=admin@example.invalid
ADMIN_NAME=Quan tri vien
